# Copy to ".env" and adjust. NEVER commit ".env".
# These are LOCAL DEVELOPMENT placeholders only. Use different, strong values anywhere else.

# --- PostgreSQL ---
DB_NAME=municipal
DB_USERNAME=municipal
DB_PASSWORD=change_me_local_only
DB_HOST=localhost
DB_PORT=5432
# Host port that Docker publishes PostgreSQL on (change if 5432 is already taken)
DB_HOST_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379
# "redis" or "simple" (in-memory fallback, no Redis needed)
CACHE_TYPE=redis

# --- JWT (HS256 needs at least 32 characters; generate your own, see README in Part 8) ---
JWT_SECRET=local-dev-only-replace-this-with-a-random-32plus-char-secret
JWT_EXPIRATION_MINUTES=60

# --- Application ---
APP_PORT=8080
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional first admin (created at startup only if no ADMIN exists) ---
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
